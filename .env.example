# Supabase (Project Settings → API). Leave blank to run on the built-in demo catalog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public site URL, used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=https://dhive.co.za

# --- Payments (server-only; never prefix with NEXT_PUBLIC_) ---
# Paystack secret key: sk_test_… while testing, sk_live_… in production.
PAYSTACK_SECRET_KEY=
# Supabase secret key (Project Settings → API Keys → Secret keys, sb_secret_…).
# Used only for webhook order updates and saving seller payout accounts.
SUPABASE_SECRET_KEY=
